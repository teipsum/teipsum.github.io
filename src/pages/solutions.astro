---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import Scenario from '../components/Scenario.astro';
import CloseCall from '../components/CloseCall.astro';
import NeedsYou from '../components/vignettes/NeedsYou.astro';
import PasskeyApproval from '../components/vignettes/PasskeyApproval.astro';
import Glance from '../components/vignettes/Glance.astro';
import Chip from '../components/Chip.astro';

const sub =
  'Unica gives a small firm a big team’s reach and gives an enterprise the controls its auditors expect, on the same governed foundation.';

const sectors = [
  {
    name: 'Financial services',
    body: 'Approvals that cannot be borrowed, and a trail a regulator can follow.',
    icon: 'finance',
    glance: {
      title: 'Approval',
      alt: 'Illustration: a payment release waiting for the treasury lead, who approves it with their own passkey, for this action only.',
      head: 'Payment release, supplier batch',
      state: { label: 'Needs you', tone: 'quiet' },
      facts: [
        { label: 'Approver', value: 'Treasury lead' },
        { label: 'Bound to', value: 'This action only' },
      ],
      action: 'Approve with passkey',
    },
  },
  {
    name: 'Healthcare',
    body: 'Personal information that stays personal, by design.',
    icon: 'health',
    glance: {
      title: 'Your twin',
      status: 'early',
      alt: 'Illustration: a clinician’s notes to their twin, readable by the clinician and, where required, their auditor, and not by an administrator.',
      head: 'Notes to your twin',
      state: { label: 'Private to you', tone: 'quiet' },
      facts: [
        { label: 'Can read', value: 'You' },
        { label: 'Your auditor', value: 'Where required' },
        { label: 'Cannot read', value: 'Administrator' },
      ],
    },
  },
  {
    name: 'Legal and professional services',
    body: 'Every claim with its citation and its standing.',
    icon: 'legal',
    glance: {
      title: 'Answer',
      status: 'early',
      alt: 'Illustration: an answer about a liability cap, citing clause 7 of a services agreement, with its standing shown as certified.',
      head: 'Liability cap: 12 months of fees',
      state: { label: 'Certified', tone: 'sealed' },
      facts: [
        { label: 'Source', value: 'Services agreement, cl. 7' },
        { label: 'Certified by', value: 'General counsel' },
      ],
    },
  },
  {
    name: 'Public sector',
    body: 'A dedicated instance, and authority that stays with your people.',
    icon: 'civic',
    glance: {
      title: 'Instance',
      alt: 'Illustration: a dedicated instance for a city office, founded by three of its own Trustees.',
      head: 'City permits office',
      state: { label: 'Dedicated' },
      facts: [
        { label: 'Founded by', value: '3 Trustees' },
        { label: 'Authority', value: 'Your people' },
      ],
    },
  },
] as const;
---

<Base title="Solutions" description={sub}>
  <PageHero eyebrow="SOLUTIONS" title="From ten people to ten thousand. Same proof." sub={sub}>
    <div slot="figure" class="scale" aria-hidden="true" data-draw>
      <div class="scale__fig draw-fade">
        <span class="scale__n">10</span>
        <span class="scale__bar scale__bar--s"></span>
      </div>
      <div class="scale__fig draw-fade">
        <span class="scale__n">10,000</span>
        <span class="scale__bar"></span>
      </div>
      <p class="scale__seal draw-fade"><Seal size={22} /><span>Same proof</span></p>
    </div>
  </PageHero>

  <Band tone="paper" id="smb" eyebrow="SMB" icon="small" heading="A small team with a big team’s reach.">
    <NeedsYou
      slot="figure"
      items={[
        { title: 'Client file ready: Rivera', from: 'Prepared overnight', action: 'Approve' },
        { title: 'Client file ready: Chen', from: 'Prepared overnight', action: 'Approve' },
        { title: 'Client file ready: Okafor', from: 'Prepared overnight', action: 'Approve' },
      ]}
      alt="Illustration: a partner's morning queue of client files prepared overnight by agents, each waiting for a one-touch approval."
    />
    <p class="lede">
      Give every person a twin and hand the back office to agents that work inside the limits you set. We run your
      dedicated instance for you, so no IT department is needed.
    </p>
    <Scenario
      text="A twelve-person accounting firm lets agents prepare client files overnight. Each partner approves with a touch in the morning, and every figure links back to its source document."
    />
  </Band>

  <Band tone="dark" id="enterprise" eyebrow="Enterprise" icon="enterprise" heading="Governed AI at the scale of your org chart." flip>
    <PasskeyApproval slot="figure" action="Vendor renewal, from 3 contracts" requester="Procurement agent" approver="CFO" />
    <p class="lede">
      Roles, scopes and approvals follow your structure. Separation of duties is enforced, not documented. Audit
      evidence is produced as work happens, not reconstructed after. <Chip status="early" />
    </p>
    <Scenario
      text="A procurement agent drafts a vendor renewal from three contracts and routes it to the CFO. The approval is bound to her, the action and that moment, and the auditor can replay all of it next quarter."
    />
  </Band>

  <section class="band band--paper" aria-labelledby="regulated">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Regulated industries</p>
        <h2 class="h2" id="regulated">When “the model said so” is not an answer.</h2>
      </div>
      <ul class="cards cards--4" data-draw>
        {
          sectors.map((s) => (
            <li class="card card--box draw-fade">
              <span class="card__icon">
                <Icon name={s.icon} />
              </span>
              <h3 class="card__title sector__title">{s.name}</h3>
              <p class="card__body">{s.body}</p>
              <div class="sector__glance">
                <Glance {...s.glance} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CloseCall
    heading="Tell us what you would hand to Unica first."
    body="The waitlist asks one question about your first use case, so the founding cohort starts where it matters."
  />
</Base>

<style>
  .lede :global(.chip) {
    vertical-align: middle;
    margin-left: 6px;
  }
  .sector__glance {
    margin-top: auto;
    padding-top: 8px;
  }
  .sector__title {
    font-size: 1.25rem;
  }
  .scale {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 420px;
    margin-left: auto;
  }
  .scale__fig {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .scale__n {
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 4.75rem);
    line-height: 0.95;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--paper);
  }
  .scale__bar {
    display: block;
    height: 6px;
    background: var(--warm);
  }
  .scale__bar--s {
    width: 14%;
  }
  .scale__seal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--hair-warm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
  }
  @media (max-width: 900px) {
    .scale {
      margin-left: 0;
    }
  }
</style>
