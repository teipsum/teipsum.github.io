---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Chip from '../components/Chip.astro';
import RecordRow from '../components/RecordRow.astro';
import Callout from '../components/Callout.astro';
import CloseCall from '../components/CloseCall.astro';

const sub =
  'Unica is built so that every claim it makes about itself can be verified: who acted, on whose authority, and why.';
---

<Base title="Trust and governance" description={sub}>
  <PageHero eyebrow="TRUST AND GOVERNANCE" title="Trust you can check." sub={sub} />

  <Band tone="paper" id="identity" eyebrow="Identity" heading="No passwords. Real people.">
    <p class="lede">
      Everyone signs in with a passkey bound to their own device. Privileged actions ask for a fresh touch, so a
      stolen session is never enough.
    </p>
    <p class="lede">
      Losing every device is planned for: recovery is part of founding, not a support ticket. <Chip status="early" />
    </p>
  </Band>

  <Band tone="dark" id="founding" eyebrow="Founding" heading="Founded by your people.">
    <p class="lede">
      Your Unica instance comes to life in a founding ceremony. Your Trustees establish it with their own passkeys, and
      governance belongs to them from the first minute.
    </p>
  </Band>

  <Band tone="paper" id="duties" eyebrow="Separation of duties" heading="No one holds every key.">
    <p class="lede">
      Trustees, Administrators and Auditors each hold distinct powers. No one can grant themselves more, and the last
      holder of a critical role cannot be removed by accident.
    </p>
  </Band>

  <Band tone="dark" id="kill-switch" eyebrow="Kill switch" heading="One pull stops it. It stays pulled." status="early">
    <p class="lede">
      Revoke an agent or a machine and it stops, everywhere, until a person with the authority deliberately brings it
      back.
    </p>
  </Band>

  <section class="band band--paper" aria-labelledby="evidence">
    <div class="wrap stack stack--lg">
      <div class="section-head evidence-head">
        <p class="eyebrow">Evidence</p>
        <h2 class="h2" id="evidence">Evidence, not logs.</h2>
        <p class="lede">
          Every act is signed and attributable, and refusals are recorded too. <Chip status="early" /> Auditors export
          evidence that stands on its own, months later. <Chip status="early" />
        </p>
      </div>
      <RecordRow />
    </div>
  </section>

  <Band tone="dark" id="privacy" eyebrow="Privacy" heading="Personal means personal." status="early">
    <p class="lede">
      A person’s words to their twin are readable by that person and their auditor. Not by an administrator.
    </p>
  </Band>

  <Band tone="paper" id="build" eyebrow="How we build it" heading="Attacked before it ships.">
    <p class="lede">
      Every change to Unica is attacked by a dedicated review team before it lands. What they find is fixed, not
      waived.
    </p>
  </Band>

  <Callout
    lead="A bug in the app cannot grant access."
    text="Rules are enforced beneath the application, in the substrate, so the interface can only show a decision. It can never make one."
  />

  <CloseCall />
</Base>

<style>
  .lede :global(.chip) {
    vertical-align: middle;
    margin-left: 6px;
  }
  .evidence-head {
    margin-bottom: 0;
  }
</style>
