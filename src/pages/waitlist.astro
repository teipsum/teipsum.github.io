---
import Base from '../layouts/Base.astro';
import Cohort from '../components/diagrams/Cohort.astro';
import { WAITLIST_ENDPOINT, PRIVACY_HREF } from '../config';

const sub =
  'Unica is admitting organizations in waves. Each wave gets hands-on onboarding and a direct line to the people building it.';

const roles = [
  ['executive', 'Executive'],
  ['it-security', 'IT or security'],
  ['operations', 'Operations'],
  ['compliance-risk', 'Compliance or risk'],
  ['engineering', 'Engineering'],
  ['other', 'Other'],
];

const sizes = ['1–10', '11–50', '51–250', '251–1,000', '1,000+'];

const industries = [
  ['financial-services', 'Financial services'],
  ['healthcare', 'Healthcare'],
  ['legal-professional', 'Legal and professional services'],
  ['public-sector', 'Public sector'],
  ['other', 'Other'],
];
---

<Base title="Join the waitlist" description={sub}>
  <section class="band--dark waitlist" aria-labelledby="page-title">
    <div class="wrap waitlist__grid">
      <div class="waitlist__intro stack stack--lg">
        <p class="eyebrow">EARLY ACCESS</p>
        <h1 class="display" id="page-title">Join the founding cohort.</h1>
        <p class="lede">{sub}</p>
        <Cohort />
      </div>

      <div class="form-card card-paper">
        <form
          id="waitlist-form"
          class="form"
          method="post"
          action={WAITLIST_ENDPOINT || undefined}
          data-endpoint={WAITLIST_ENDPOINT}
          aria-labelledby="form-title"
        >
          <h2 class="visually-hidden" id="form-title">Request early access</h2>

          <div class="error-summary" id="error-summary" tabindex="-1" hidden>
            <h3 class="error-summary__title">Please check the highlighted fields.</h3>
            <ul class="error-summary__list"></ul>
          </div>

          <p class="form__hint">All fields are required unless marked optional.</p>

          <div class="field">
            <label for="f-email">Work email</label>
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              maxlength="254"
              required
              aria-describedby="f-email-error"
            />
            <p class="field__error" id="f-email-error" hidden></p>
          </div>

          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" maxlength="200" required aria-describedby="f-name-error" />
            <p class="field__error" id="f-name-error" hidden></p>
          </div>

          <div class="field">
            <label for="f-org">Organization</label>
            <input
              id="f-org"
              name="organization"
              type="text"
              autocomplete="organization"
              maxlength="200"
              required
              aria-describedby="f-org-error"
            />
            <p class="field__error" id="f-org-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-role">Role</label>
              <div class="select">
                <select id="f-role" name="role" required aria-describedby="f-role-error">
                  <option value="">Choose…</option>
                  {roles.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </div>
              <p class="field__error" id="f-role-error" hidden></p>
            </div>

            <div class="field">
              <label for="f-size">Organization size</label>
              <div class="select">
                <select id="f-size" name="size" required aria-describedby="f-size-error">
                  <option value="">Choose…</option>
                  {sizes.map((s) => <option value={s}>{s}</option>)}
                </select>
              </div>
              <p class="field__error" id="f-size-error" hidden></p>
            </div>
          </div>

          <div class="field">
            <label for="f-industry">Industry <span class="optional">(optional)</span></label>
            <div class="select">
              <select id="f-industry" name="industry">
                <option value="">Choose…</option>
                {industries.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-first">What would you hand to Unica first? <span class="optional">(optional)</span></label>
            <input id="f-first" name="first_use" type="text" maxlength="280" autocomplete="off" />
          </div>

          <div class="field field--check">
            <input id="f-consent" name="consent" type="checkbox" value="true" required aria-describedby="f-consent-error" />
            <p class="field__check-text">
              <label for="f-consent">I agree to be contacted about early access.</label>{' '}
              <a href={PRIVACY_HREF}>Privacy notice</a>
            </p>
            <p class="field__error" id="f-consent-error" hidden></p>
          </div>

          <div class="hp" aria-hidden="true">
            <label for="f-website">Leave this field empty</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form__submit">
            <button class="btn btn--solid" type="submit">Request early access</button>
          </div>

          <p class="form__status" id="form-status" role="status" aria-live="polite"></p>

          <noscript>
            <p class="form__status form__status--notice">This form needs JavaScript to send your request.</p>
          </noscript>
        </form>

        <div class="confirmation" id="confirmation" hidden>
          <h2 class="h2" id="confirmation-title" tabindex="-1">You’re on the list.</h2>
          <p class="confirmation__body">
            A person on our team reads every request. When your wave begins, you’ll hear from us directly, not from an
            autoresponder.
          </p>
        </div>

        <p class="form-card__note">
          <em>Investor or analyst? Say so in the last field and we’ll route you to the right conversation.</em>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initWaitlist } from '../scripts/waitlist';
  initWaitlist();
</script>

<style>
  .waitlist {
    padding-block: clamp(40px, 2rem + 3.4vw, 80px);
  }
  .waitlist__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: start;
  }
  .waitlist__intro {
    grid-column: span 5;
    position: sticky;
    top: calc(var(--header-h) + 48px);
  }
  .form-card {
    grid-column: 7 / span 6;
  }
  @media (max-width: 960px) {
    .waitlist__intro,
    .form-card {
      grid-column: 1 / -1;
      position: static;
    }
  }

  .form-card {
    --focus: var(--accent);
    background: var(--paper);
    color: var(--ink);
    padding: clamp(24px, 4vw, 48px);
    border-top: 2px solid var(--warm);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form__hint {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px var(--col-gap);
  }
  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  label {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .optional {
    font-weight: 400;
    color: var(--ink-soft);
  }

  input[type='text'],
  input[type='email'],
  select {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--ink-soft);
    border-radius: 0;
  }

  input[type='text']:focus-visible,
  input[type='email']:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  [aria-invalid='true'] {
    border: 2px solid var(--accent) !important;
  }

  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }
  .select::after {
    content: '';
    position: absolute;
    right: 18px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field--check {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 14px;
    row-gap: 8px;
  }
  .field--check input {
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--accent);
  }
  .field--check label {
    font-weight: 400;
  }
  .field__check-text {
    font-size: 1rem;
    line-height: 1.4;
  }
  .field__check-text a {
    padding-block: 3px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .field--check .field__error {
    grid-column: 1 / -1;
  }

  .field__error {
    display: flex;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
  }
  .field__error::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .error-summary {
    padding: 16px 20px;
    border: 2px solid var(--accent);
  }
  .error-summary__title {
    font-size: 1.0625rem;
    font-weight: 500;
    margin: 0 0 8px;
  }
  .error-summary__list {
    margin: 0;
    padding-left: 20px;
  }
  .error-summary__list :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .form__submit .btn {
    width: 100%;
    font-size: 1.0625rem;
  }
  .form__submit .btn[aria-disabled='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .form__status:empty {
    display: none;
  }
  .form__status {
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: rgba(139, 94, 60, 0.06);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .confirmation {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .confirmation[hidden] {
    display: none;
  }
  .confirmation__body {
    font-size: var(--fs-lede);
    line-height: 1.55;
    color: var(--ink-strong);
  }

  .form-card__note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
</style>
