---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import CloseCall from '../components/CloseCall.astro';
import Icon from '../components/Icon.astro';
import StepTrace from '../components/diagrams/StepTrace.astro';
import '../styles/pages/company.css';

const sub =
  'The oldest instruction in philosophy is our product description. We build the platform that lets organizations, and the people in them, know what they know, how they know it, and whether to trust it.';

const beliefs = [
  {
    title: 'Trust should be provable.',
    icon: 'seal',
    body: '“The system said so” should be something you can check, not take on faith.',
  },
  { title: 'Authority belongs to people.', body: 'AI can do the work. People hold the keys.', icon: 'key' },
  { title: 'Your context is yours.', body: 'What your organization knows should stay under your control.', icon: 'cell' },
] as const;

const triad = [
  { label: 'Record', icon: 'record' },
  { label: 'Rulebook', icon: 'rulebook' },
  { label: 'Trail', icon: 'trail' },
] as const;

const founderBio = 'Michael was Senior Director of Data Governance at Walmart, and at EPAM he was Senior Delivery Manager for AI and advanced analytics across Latin America. Before that, he served as a Marine Corps NCO.';
---

<Base page="company" title="Company" description={sub} serif>
  <PageHero eyebrow="TEIPSUM" title="Scito te ipsum. Know thyself." sub={sub}>
    <Fragment slot="title"><span class="motto" lang="la">Scito te ipsum.</span> Know thyself.</Fragment>
  </PageHero>

  <section class="band band--paper" aria-labelledby="beliefs">
    <div class="wrap">
      <div class="section-head">
        <h2 class="eyebrow" id="beliefs">What we believe</h2>
      </div>
      <ul class="cards cards--3 beliefs" data-draw>
        {
          beliefs.map((b) => (
            <li class="card card--box draw-fade">
              <span class="card__icon">
                <Icon name={b.icon} />
              </span>
              <h3 class="card__title">{b.title}</h3>
              <p class="card__body">{b.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Band tone="dark" id="uniquely" heading="Uniquely yourself" icon="twin" flip>
    <ul slot="figure" class="triad" data-draw>
      {
        triad.map((t) => (
          <li class="triad__item draw-fade">
            <span class="triad__icon"><Icon name={t.icon} size={30} /></span>
            <span class="triad__label">{t.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="lede">
      For a person, Unica is a twin that remembers them the way they choose to be remembered. For an organization, it
      is a record that cannot be lost, a rulebook that cannot be bypassed, and a trail of who did what, and on whose authority.
    </p>
  </Band>

  <Band tone="paper" id="run-on-it" eyebrow="We run on it" icon="shield" heading="Our first customer is us.">
    <StepTrace
      slot="figure"
      alt="Diagram: every change is proposed, attacked by reviewers, approved by a person, and recorded."
      steps={[
        { label: 'Proposed', icon: 'assert' },
        { label: 'Attacked', icon: 'find' },
        { label: 'Approved', icon: 'fingerprint' },
      ]}
      end="Recorded"
    />
    <p class="lede">
      Unica is built by a governed team of people and AI agents working inside the same substrate we sell. Every change
      is proposed, attacked by reviewers, approved by a person and recorded. This is not a design document; our company
      already runs this way.
    </p>
  </Band>

  <section class="band band--paper band--flush-top" aria-labelledby="leadership">
    <div class="wrap">
      <div class="leadership">
        <div class="leadership__head">
          <h2 class="eyebrow" id="leadership">Leadership</h2>
          <img
            class="portrait"
            src="/images/michael-cram-480.jpg"
            srcset="/images/michael-cram-480.jpg 480w, /images/michael-cram-960.jpg 960w"
            sizes="240px"
            width="240"
            height="300"
            loading="lazy"
            decoding="async"
            alt="Michael Cram, founder and CEO of Teipsum"
          />
        </div>
        <div class="person">
          <p class="person__name"><strong>Michael Cram</strong>, Founder and CEO.</p>
          <p class="person__bio">{founderBio}</p>
        </div>
      </div>
    </div>
  </section>

  <CloseCall />
</Base>
