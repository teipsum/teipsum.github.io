---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Timeline from '../components/Timeline.astro';
import Callout from '../components/Callout.astro';
import CloseCall from '../components/CloseCall.astro';
import { WAITLIST_HREF, CTA_LABEL } from '../config';

const sub =
  'CQR is the substrate beneath Unica. It holds what your organization knows as records with provenance, authority and history, and it decides who may read or change each one.';

const primitives = [
  { verb: 'Find', rest: 'what is known and how it connects.' },
  { verb: 'Trace', rest: 'any answer to its origins.' },
  { verb: 'Compare', rest: 'what changed.' },
  { verb: 'Assert', and: 'update', rest: 'with provenance.' },
  { verb: 'Certify', and: 'signal', rest: 'standing.' },
  { verb: 'Hypothesize', rest: 'before acting.' },
];
---

<Base title="Technology: CQR, the governed context substrate" description={sub}>
  <PageHero eyebrow="CQR · THE GOVERNED CONTEXT SUBSTRATE" title="The ground truth under every agent." sub={sub} />

  <Band tone="paper" id="why" eyebrow="Why a substrate" heading="Models forget. Records don’t.">
    <p class="lede">
      Language models are brilliant and stateless. Agents that do real work need a memory that is governed: every fact
      with its source, its confidence and its standing.
    </p>
  </Band>

  <Band tone="dark" id="provenance" eyebrow="Provenance" heading="Know what you know, how you know it, and whether to trust it.">
    <p class="lede">
      Ask CQR a question and you get the answer, its sources, how confident to be, and who certified it.
    </p>
  </Band>

  <Band tone="paper" id="authority" eyebrow="Authority at the source" heading="Decided where the data lives.">
    <p class="lede">
      Access and authority are decided in one place, for every agent, app and integration. No layer above can quietly
      widen them.
    </p>
  </Band>

  <section class="band band--dark" aria-labelledby="history">
    <div class="wrap split">
      <div class="split__text stack">
        <p class="eyebrow">History</p>
        <h2 class="h2" id="history">Nothing silently overwritten.</h2>
        <p class="lede">
          Records are versioned, never erased in place. Ask what your organization knew on any past date and get the
          answer it would have given then.
        </p>
      </div>
      <div class="split__figure">
        <Timeline />
      </div>
    </div>
  </section>

  <Band tone="paper" id="standing" eyebrow="Standing" heading="Facts earn their standing.">
    <p class="lede">
      A record can be asserted, certified by someone with the authority to certify it, contested, or superseded. Agents
      see the difference and act on it.
    </p>
  </Band>

  <Band tone="dark" id="relied-on" eyebrow="Built to be relied on" heading="Standards in. Lock-in out.">
    <p class="lede">
      CQR speaks the Model Context Protocol, the emerging standard for connecting AI agents to context, so the agents
      you already use can work inside it. It runs on the Erlang runtime built for telephone switches that were not
      allowed to fall over.
    </p>
    <div class="actions">
      <a class="btn btn--solid" href={WAITLIST_HREF}>{CTA_LABEL}</a>
    </div>
  </Band>

  <section class="band band--paper" aria-labelledby="primitives">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The primitives</p>
        <h2 class="h2" id="primitives">A small, complete vocabulary for agents that must be right.</h2>
      </div>
      <ul class="cards primitives">
        {
          primitives.map((p) => (
            <li class="card card--warm">
              <p class="card__title">
                <em class="term">{p.verb}</em>
                {p.and && (
                  <>
                    {' and '}
                    <em class="term">{p.and}</em>
                  </>
                )}{' '}
                {p.rest}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Callout
    lead="Agents don’t get a database. They get an epistemology."
    text="Every answer arrives with its reasons attached."
  />

  <CloseCall />
</Base>

<style>
  .primitives {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .primitives .card__title {
    font-weight: 300;
    color: var(--ink-strong);
  }
  .primitives .term {
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .primitives {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .primitives {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
