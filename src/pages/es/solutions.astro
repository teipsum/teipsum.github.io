---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import Icon from '../../components/Icon.astro';
import Seal from '../../components/Seal.astro';
import Scenario from '../../components/Scenario.astro';
import CloseCall from '../../components/CloseCall.astro';
import NeedsYou from '../../components/vignettes/NeedsYou.astro';
import PasskeyApproval from '../../components/vignettes/PasskeyApproval.astro';
import Glance from '../../components/vignettes/Glance.astro';
import Chip from '../../components/Chip.astro';

const sub =
  'Unica le da a una firma pequeña el alcance de un gran equipo y a una gran empresa los controles que esperan sus auditores, sobre la misma base gobernada.';

const sectors = [
  {
    name: 'Servicios financieros',
    body: 'Aprobaciones que nadie puede pedir prestadas, y un rastro que un regulador puede seguir.',
    icon: 'finance',
    glance: {
      title: 'Aprobación',
      alt: 'Ilustración: una liberación de pago a la espera del responsable de Tesorería, que la aprueba con su propia llave de acceso, solo para esta acción.',
      head: 'Liberación de pago, lote de proveedores',
      state: { label: 'Te espera', tone: 'quiet' },
      facts: [
        { label: 'Aprueba', value: 'Responsable de Tesorería' },
        { label: 'Vinculada a', value: 'Solo esta acción' },
      ],
      action: 'Aprobar con llave de acceso',
    },
  },
  {
    name: 'Salud',
    body: 'Información personal que sigue siendo personal, por diseño.',
    icon: 'health',
    glance: {
      title: 'Tu gemelo',
      status: 'early',
      alt: 'Ilustración: las notas de un médico para su gemelo, que pueden leer el propio médico y, cuando se exija, su auditor, pero no un administrador.',
      head: 'Notas para tu gemelo',
      state: { label: 'Solo para ti', tone: 'quiet' },
      facts: [
        { label: 'Puede leer', value: 'Tú' },
        { label: 'Tu auditor', value: 'Cuando se exija' },
        { label: 'No puede leer', value: 'Administrador' },
      ],
    },
  },
  {
    name: 'Servicios legales y profesionales',
    body: 'Cada afirmación con su cita y su estatus.',
    icon: 'legal',
    glance: {
      title: 'Respuesta',
      status: 'early',
      alt: 'Ilustración: una respuesta sobre un tope de responsabilidad que cita la cláusula 7 de un contrato de servicios, con su estatus de certificada.',
      head: 'Tope de responsabilidad: 12 meses de honorarios',
      state: { label: 'Certificada', tone: 'sealed' },
      facts: [
        { label: 'Fuente', value: 'Contrato de servicios, cl. 7' },
        { label: 'Certificada por', value: 'Dirección jurídica' },
      ],
    },
  },
  {
    name: 'Sector público',
    body: 'Una instancia dedicada, y una autoridad que se queda con tu gente.',
    icon: 'civic',
    glance: {
      title: 'Instancia',
      alt: 'Ilustración: una instancia dedicada para una oficina municipal, fundada por tres de sus propios Fideicomisarios.',
      head: 'Oficina municipal de permisos',
      state: { label: 'Dedicada' },
      facts: [
        { label: 'Fundada por', value: '3 Fideicomisarios' },
        { label: 'Autoridad', value: 'Tu gente' },
      ],
    },
  },
] as const;
---

<Base title="Soluciones" description={sub}>
  <PageHero eyebrow="Soluciones" title="De diez personas a diez mil. La misma prueba." sub={sub}>
    <div slot="figure" class="scale" aria-hidden="true" data-draw>
      <div class="scale__fig draw-fade">
        <span class="scale__n">10</span>
        <span class="scale__bar scale__bar--s"></span>
      </div>
      <div class="scale__fig draw-fade">
        <span class="scale__n">10.000</span>
        <span class="scale__bar"></span>
      </div>
      <p class="scale__seal draw-fade"><Seal size={22} /><span>La misma prueba</span></p>
    </div>
  </PageHero>

  <Band tone="paper" id="smb" eyebrow="Pymes" icon="small" heading="Un equipo pequeño con el alcance de uno grande.">
    <NeedsYou
      slot="figure"
      status="early"
      items={[
        { title: 'Expediente listo: Rivera', from: 'Preparado durante la noche', action: 'Aprobar' },
        { title: 'Expediente listo: Chen', from: 'Preparado durante la noche', action: 'Aprobar' },
        { title: 'Expediente listo: Okafor', from: 'Preparado durante la noche', action: 'Aprobar' },
      ]}
      alt="Ilustración: la cola matutina de un socio, con expedientes de clientes que los agentes prepararon durante la noche, cada uno a la espera de una aprobación con un solo toque."
    />
    <p class="lede">
      Dale un gemelo a cada persona y deja las tareas administrativas en manos de agentes que trabajan dentro de los
      límites que fijas. Nosotros operamos tu instancia dedicada, así que no necesitas un departamento de TI.
    </p>
    <Scenario
      text="Una firma contable de doce personas deja que los agentes preparen los expedientes de sus clientes durante la noche. Cada socio aprueba con un toque por la mañana, y cada cifra enlaza con su documento de origen."
    />
  </Band>

  <Band tone="dark" id="enterprise" eyebrow="Grandes empresas" icon="enterprise" heading="IA gobernada a la escala de tu organigrama." flip>
    <PasskeyApproval slot="figure" action="Renovación de proveedor, a partir de 3 contratos" requester="Agente de compras" approver="CFO" />
    <p class="lede">
      Los roles, los alcances y las aprobaciones siguen tu estructura. La separación de funciones se aplica, no se
      documenta. La evidencia de auditoría se produce mientras ocurre el trabajo, no se reconstruye después. <Chip status="early" />
    </p>
    <Scenario
      text="Un agente de compras redacta la renovación de un proveedor a partir de tres contratos y la envía a la CFO. La aprobación queda vinculada a ella, a la acción y a ese momento, y el auditor puede reproducirlo todo el próximo trimestre."
    />
  </Band>

  <section class="band band--paper" aria-labelledby="regulated">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Industrias reguladas</p>
        <h2 class="h2" id="regulated">Cuando «lo dijo el modelo» no es una respuesta.</h2>
      </div>
      <ul class="cards cards--4" data-draw>
        {
          sectors.map((s) => (
            <li class="card card--box draw-fade">
              <span class="card__icon">
                <Icon name={s.icon} />
              </span>
              <h3 class="card__title sector__title">{s.name}</h3>
              <p class="card__body">{s.body}</p>
              <div class="sector__glance">
                <Glance {...s.glance} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CloseCall
    heading="Cuéntanos qué le confiarías primero a Unica."
    body="La lista de espera hace una sola pregunta sobre tu primer caso de uso, para que la cohorte fundadora empiece donde importa."
  />
</Base>

<style>
  .lede :global(.chip) {
    vertical-align: middle;
    margin-left: 6px;
  }
  .sector__glance {
    margin-top: auto;
    padding-top: 8px;
  }
  .sector__title {
    font-size: 1.25rem;
  }
  .scale {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 420px;
    margin-left: auto;
  }
  .scale__fig {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .scale__n {
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 4.75rem);
    line-height: 0.95;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--paper);
  }
  .scale__bar {
    display: block;
    height: 6px;
    background: var(--warm);
  }
  .scale__bar--s {
    width: 14%;
  }
  .scale__seal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--hair-warm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
  }
  @media (max-width: 900px) {
    .scale {
      margin-left: 0;
    }
  }
</style>
