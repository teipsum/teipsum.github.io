---
// Closing band with the waitlist button.
import TraceRule from './TraceRule.astro';
import { WAITLIST_HREF } from '../config';
import { UI, langOf, localize } from '../i18n';

interface Props {
  heading?: string;
  body?: string;
  smallPrint?: string;
}
const { heading, body, smallPrint } = Astro.props;
const id = heading ? 'close-heading' : undefined;
const lang = langOf(Astro.url);
const cta = UI[lang].cta;
---

<section class="band band--dark close-band" aria-labelledby={id} aria-label={id ? undefined : cta}>
  <div class="wrap close-call">
    <TraceRule />
    {heading && <h2 class="h2" id={id}>{heading}</h2>}
    {body && <p class="lede">{body}</p>}
    {smallPrint && <p class="small-print">{smallPrint}</p>}
    <a class="btn btn--solid" href={localize(WAITLIST_HREF, lang)}>{cta}</a>
  </div>
</section>

<style>
  .close-band {
    padding-block: clamp(56px, 3.5rem + 2.6vw, 92px);
  }
</style>
