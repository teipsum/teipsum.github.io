---
// Vignette: one signed record, the whole product in one glance.
import Vignette from './Vignette.astro';
import Seal from '../Seal.astro';
import { pick } from '../../i18n';

// Signed records are in early access, so the card carries the chip.
const t = pick<{ title: string; alt: string; head: string; sealed: string; rows: { label: string; value: string; mono?: boolean }[] }>(
  Astro.url,
  {
    en: {
      title: 'Record',
      alt: 'Illustration: a signed record of a contract renewal, showing its three source documents, the agent that acted and for whom, the approver, the time, and its seal.',
      head: 'Contract renewal approved',
      sealed: 'Sealed',
      rows: [
        { label: 'Sources', value: '3 documents' },
        { label: 'Acted', value: 'Procurement agent, for Dana Ortiz' },
        { label: 'Approved', value: 'CFO, passkey' },
        { label: 'Time', value: '14:02 UTC', mono: true },
      ],
    },
    es: {
      title: 'Registro',
      alt: 'Ilustración: el registro firmado de una renovación de contrato, con sus tres documentos fuente, el agente que actuó y en nombre de quién, quién lo aprobó, la hora y su sello.',
      head: 'Renovación de contrato aprobada',
      sealed: 'Sellado',
      rows: [
        { label: 'Fuentes', value: '3 documentos' },
        { label: 'Actuó', value: 'Agente de compras, en nombre de Dana Ortiz' },
        { label: 'Aprobó', value: 'CFO, llave de acceso' },
        { label: 'Hora', value: '14:02 UTC', mono: true },
      ],
    },
  },
);
const rows = t.rows;
---

<Vignette title={t.title} status="early" alt={t.alt}>
  <div class="v-row">
    <span class="v-title">{t.head}</span>
    <span class="v-chip v-chip--solid"><Seal size={12} />{t.sealed}</span>
  </div>
  <dl class="rc">
    {
      rows.map((r) => (
        <div class="rc__row">
          <dt class="v-label">{r.label}</dt>
          <dd class:list={[r.mono && 'v-mono']}>{r.value}</dd>
        </div>
      ))
    }
  </dl>
  <svg class="rc__trace" viewBox="0 0 400 28" fill="none" aria-hidden="true" preserveAspectRatio="none">
    <line class="draw-line" x1="6" y1="14" x2="380" y2="14" pathLength="1"></line>
    <circle cx="6" cy="14" r="3.5"></circle>
    <circle cx="70" cy="14" r="3.5"></circle>
    <circle cx="134" cy="14" r="3.5"></circle>
  </svg>
</Vignette>

<style>
  .rc {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .rc__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 12px;
    padding-block: 9px;
    border-top: 1px solid var(--v-hair);
    align-items: baseline;
  }
  dd {
    margin: 0;
    color: var(--v-ink);
  }
  .rc__trace {
    width: 100%;
    height: 20px;
  }
  .rc__trace line {
    stroke: var(--v-signal);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .rc__trace circle {
    fill: var(--v-signal);
  }
  @media (max-width: 400px) {
    .rc__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
