---
// Vignette: a person and their twin, privately.
import Vignette from './Vignette.astro';
import Icon from '../Icon.astro';

interface Message {
  from: 'you' | 'twin';
  text: string;
}
interface Props {
  messages?: Message[];
  alt?: string;
  actions?: string[];
}
const {
  messages = [
    { from: 'you', text: 'Draft a reply to the supplier. Keep it short.' },
    { from: 'twin', text: 'Here is a draft in your voice. Nothing goes out until you say so.' },
  ],
  actions = ['Send', 'Edit'],
  alt = 'Illustration: a person asks their twin to draft a reply; the twin drafts it in their voice and waits for their go-ahead. The conversation is private to that person.',
} = Astro.props;
---

<Vignette title="Your twin" alt={alt}>
  <ol class="tw">
    {
      messages.map((m) => (
        <li class:list={['tw__msg', `tw__msg--${m.from}`]}>
          <span class="v-label">{m.from === 'you' ? 'You' : 'Your twin'}</span>
          <span class="tw__bubble">{m.text}</span>
        </li>
      ))
    }
  </ol>
  <div class="v-row v-divide tw__foot">
    <span class="tw__private v-meta"><Icon name="lock" size={14} />Private to you</span>
    <span class="tw__actions">
      {actions.map((a, i) => <span class:list={['v-btn', i > 0 && 'v-btn--ghost']}>{a}</span>)}
    </span>
  </div>
</Vignette>

<style>
  .tw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tw__msg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 88%;
  }
  .tw__msg--you {
    align-self: flex-end;
    align-items: flex-end;
  }
  .tw__bubble {
    padding: 10px 14px;
    border: 1px solid var(--v-hair);
    background: #fff;
    color: var(--v-ink);
  }
  .tw__msg--twin .tw__bubble {
    border-left: 2px solid var(--v-signal);
  }
  .tw__foot {
    padding-top: 12px;
    flex-wrap: wrap;
  }
  .tw__private {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tw__private :global(.icon) {
    color: var(--v-signal);
  }
  .tw__actions {
    display: flex;
    gap: 8px;
  }
</style>
