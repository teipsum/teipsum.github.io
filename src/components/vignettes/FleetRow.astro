---
// Vignette: the fleet view, one row per agent with its owner and how long it
// has been idle. The stopped variant shows a revoked agent.
import Vignette from './Vignette.astro';
import Icon from '../Icon.astro';
import { pick } from '../../i18n';

interface Agent {
  name: string;
  owner: string;
  area: string;
  idle: string;
  state: 'working' | 'idle' | 'stopped';
}
interface Props {
  agents?: Agent[];
  title?: string;
  alt?: string;
  status?: 'early' | 'roadmap';
}

const t = pick<{
  agents: Agent[];
  title: string;
  alt: string;
  state: Record<Agent['state'], string>;
  since: Record<Agent['state'], string>;
  area: string;
  owner: string;
}>(Astro.url, {
  en: {
    agents: [
      { name: 'Invoice intake agent', owner: 'Dana Ortiz', area: 'Finance', idle: 'Now', state: 'working' },
      { name: 'Contract review agent', owner: 'Sam Reyes', area: 'Legal', idle: '09:40', state: 'idle' },
      { name: 'Supplier follow-up agent', owner: 'Lee Park', area: 'Operations', idle: 'Mon 16:12', state: 'idle' },
    ],
    title: 'Agents',
    alt: 'Illustration: a list of agents, each showing its business area, its human owner and when it was last active.',
    state: { working: 'Working', idle: 'Idle', stopped: 'Stopped' },
    since: { working: 'Active', idle: 'Idle since', stopped: 'Stopped at' },
    area: 'Area',
    owner: 'Owner',
  },
  es: {
    agents: [
      { name: 'Agente de recepción de facturas', owner: 'Dana Ortiz', area: 'Finanzas', idle: 'Ahora', state: 'working' },
      { name: 'Agente de revisión de contratos', owner: 'Sam Reyes', area: 'Legal', idle: '09:40', state: 'idle' },
      { name: 'Agente de seguimiento de proveedores', owner: 'Lee Park', area: 'Operaciones', idle: 'lun 16:12', state: 'idle' },
    ],
    title: 'Agentes',
    alt: 'Ilustración: una lista de agentes, cada uno con su área de negocio, su responsable humano y la última vez que estuvo activo.',
    state: { working: 'Trabajando', idle: 'Inactivo', stopped: 'Detenido' },
    since: { working: 'Activo', idle: 'Inactivo desde', stopped: 'Detenido a las' },
    area: 'Área',
    owner: 'Responsable',
  },
});
const { agents = t.agents, title = t.title, alt = t.alt, status } = Astro.props;
const stateLabel = t.state;
---

<Vignette title={title} alt={alt} status={status}>
  <ul class="v-list fleet">
    {
      agents.map((a) => (
        <li class:list={['fleet__row', `fleet__row--${a.state}`]}>
          <div class="v-row">
            <span class="v-strong">{a.name}</span>
            <span class:list={['v-chip', a.state === 'idle' && 'v-chip--quiet', a.state === 'stopped' && 'v-chip--solid']}>
              {a.state === 'stopped' && <Icon name="power" size={12} />}
              {stateLabel[a.state]}
            </span>
          </div>
          <dl class="fleet__meta">
            <div><dt class="v-label">{t.area}</dt><dd>{a.area}</dd></div>
            <div><dt class="v-label">{t.owner}</dt><dd>{a.owner}</dd></div>
            <div><dt class="v-label">{t.since[a.state]}</dt><dd class="v-mono">{a.idle}</dd></div>
          </dl>
        </li>
      ))
    }
  </ul>
</Vignette>

<style>
  .fleet__row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .fleet__meta {
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    font-size: 0.8125rem;
  }
  .fleet__meta div {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .fleet__meta dd {
    margin: 0;
    color: var(--v-text);
  }
  .fleet__row--stopped .v-strong {
    text-decoration: line-through;
    text-decoration-color: var(--v-signal);
  }
  .fleet__row :global(.icon) {
    color: currentColor;
  }
</style>
