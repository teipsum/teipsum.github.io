---
// Frame for every product vignette: a stylised panel, never a screenshot,
// always tagged as illustrative. The drawing inside is one image with a text
// alternative, so screen readers hear the description, not the parts. A
// capability in early access carries its status chip in the bar.
import Chip from '../Chip.astro';

interface Props {
  /** Short panel title shown in the bar. */
  title: string;
  /** Text alternative for the whole vignette. */
  alt: string;
  status?: 'early' | 'roadmap';
  /** Compact panel for cards and tiles. */
  mini?: boolean;
  class?: string;
}
const { title, alt, status, mini = false, class: className } = Astro.props;
---

<figure class:list={['vig', mini && 'vig--mini', className]} data-draw>
  <figcaption class="vig__bar">
    <span class="vig__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="vig__title">{title}</span>
    {status && <Chip status={status} />}
    <span class="vig__tag">Illustrative</span>
  </figcaption>
  <div class="vig__screen draw-fade" role="img" aria-label={alt}>
    <slot />
  </div>
</figure>
