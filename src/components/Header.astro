---
import Wordmark from './Wordmark.astro';
import { NAV, WAITLIST_HREF, CTA_LABEL } from '../config';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <Wordmark />

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__end">
      <a
        class="btn btn--outline site-header__cta"
        href={WAITLIST_HREF}
        aria-current={isCurrent(WAITLIST_HREF) ? 'page' : undefined}>{CTA_LABEL}</a
      >

      <details class="nav-mobile">
        <summary>
          <span class="visually-hidden">Menu</span>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
            <path class="nav-mobile__open" d="M2 6h18M2 11h18M2 16h18"></path>
            <path class="nav-mobile__close" d="M4 4l14 14M18 4L4 18"></path>
          </svg>
        </summary>
        <nav aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid var(--hair-warm);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
  }

  .nav-desktop a,
  .nav-mobile a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--paper-strong);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .nav-desktop a:hover,
  .nav-mobile a:hover {
    color: var(--paper);
  }

  .nav-desktop a[aria-current='page'],
  .nav-mobile a[aria-current='page'] {
    color: var(--warm);
  }

  .nav-desktop a[aria-current='page'] {
    box-shadow: inset 0 -1px 0 var(--warm);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .site-header__cta {
    min-height: 44px;
    padding: 10px 20px;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .site-header__cta[aria-current='page'] {
    background: var(--warm);
    color: var(--ink);
  }

  .nav-mobile {
    display: none;
  }

  .nav-mobile summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    list-style: none;
    cursor: pointer;
    color: var(--paper);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile svg path {
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }

  .nav-mobile__close {
    display: none;
  }

  .nav-mobile[open] .nav-mobile__open {
    display: none;
  }

  .nav-mobile[open] .nav-mobile__close {
    display: inline;
  }

  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--ink);
    border-bottom: 1px solid var(--hair-warm);
    padding: 8px var(--gutter) 20px;
  }

  .nav-mobile li + li {
    border-top: 1px solid var(--hair-dark-faint);
  }

  .nav-mobile a {
    width: 100%;
    min-height: 52px;
    font-size: 1.0625rem;
  }

  @media (max-width: 1040px) {
    .nav-desktop {
      display: none;
    }
    .nav-mobile {
      display: block;
    }
  }

  @media (max-width: 380px) {
    .site-header__bar {
      gap: 8px;
    }
    .site-header__end {
      gap: 4px;
    }
    .site-header__cta {
      padding: 10px 12px;
      letter-spacing: 0;
    }
  }
</style>
