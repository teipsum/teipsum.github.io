---
// Thin line icons on a 24 px grid, drawn in the current text colour (bronze
// by default). Decorative unless a label is given.
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  label?: string;
  class?: string;
}

const ICONS = {
  // Pillars and beliefs
  seal: '<circle cx="12" cy="12" r="9"/><path d="M7.5 12.2l3 3 6-6.4"/>',
  key: '<circle cx="8" cy="12" r="4"/><path d="M12 12h9M18 12v3M21 12v2.5"/>',
  cell: '<path d="M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9z"/><circle cx="12" cy="12" r="2.2"/>',
  // Outcomes
  payroll: '<rect x="3.5" y="7.5" width="17" height="12" rx="1"/><path d="M9 7.5V5h6v2.5M3.5 12.5h17"/>',
  backlog: '<path d="M4 19.5h16M6 15.5h12M8 11.5h8"/><path d="M12 8V3.5M9.5 6L12 3.5 14.5 6"/>',
  audit: '<rect x="5" y="4" width="14" height="16.5" rx="1"/><path d="M9 4V2.8h6V4M8.5 12.5l2.5 2.5 4.5-5"/>',
  judgment: '<path d="M12 4v16M8 20h8M5 7h14"/><path d="M5 7l-2.5 6h5zM19 7l-2.5 6h5z"/>',
  // Steps and trust
  flag: '<path d="M6 21V3.5M6 4.5h11l-2.5 4 2.5 4H6"/>',
  scope: '<rect x="4" y="4" width="16" height="16" rx="1" stroke-dasharray="2.5 2.5"/><circle cx="12" cy="12" r="3.5"/>',
  fingerprint:
    '<path d="M7.5 18.5c1-2 1.5-4 1.5-6.5a3 3 0 0 1 6 0c0 3-.5 5.5-1.8 8"/><path d="M12 12c0 3.5-.8 6.3-2.4 8.5"/><path d="M4.5 15c.7-1.2 1-2.2 1-3.5a6.5 6.5 0 0 1 13 0c0 1.6-.1 3-.4 4.4"/>',
  roles: '<circle cx="6" cy="8" r="2.5"/><circle cx="18" cy="8" r="2.5"/><circle cx="12" cy="15" r="2.5"/><path d="M8.2 9.3l2.2 3.8M15.8 9.3l-2.2 3.8"/>',
  power: '<path d="M12 3.5v8"/><path d="M7.2 6.3a7.5 7.5 0 1 0 9.6 0"/>',
  evidence: '<path d="M6 3.5h8.5L19 8v12.5H6z"/><path d="M14 3.5V8h5"/><circle cx="12.5" cy="14.5" r="3"/><path d="M11.2 14.6l1 1 1.8-2"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="1"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 14.5v2.5"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  // Capabilities
  connect: '<path d="M9 3.5v4M15 3.5v4M6.5 7.5h11v3a5.5 5.5 0 0 1-11 0z"/><path d="M12 16v4.5"/>',
  twin: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="8.5" r="3" stroke-dasharray="2 2"/><path d="M16 14.1a5.5 5.5 0 0 1 4.5 5.4"/>',
  brain: '<circle cx="12" cy="12" r="2.5"/><circle cx="5" cy="6" r="1.8"/><circle cx="19" cy="6" r="1.8"/><circle cx="5" cy="18" r="1.8"/><circle cx="19" cy="18" r="1.8"/><path d="M6.4 7.2l3.7 3.2M17.6 7.2l-3.7 3.2M6.4 16.8l3.7-3.2M17.6 16.8l-3.7-3.2"/>',
  collaborate: '<circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><path d="M9 12h6"/><path d="M12 5v4M12 15v4" stroke-dasharray="1.5 2"/>',
  areas: '<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="3.5" width="7" height="7" rx="1"/><rect x="3.5" y="13.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1"/><path d="M10.5 7h3" />',
  build: '<path d="M14.5 5.5a4 4 0 0 0-5 5L4 16l4 4 5.5-5.5a4 4 0 0 0 5-5l-2.5 2.5-2.5-.5-.5-2.5z"/>',
  dial: '<path d="M4 16a8 8 0 0 1 16 0"/><path d="M12 16l4-5"/><circle cx="12" cy="16" r="1.2"/><path d="M4 19.5h16"/>',
  resume: '<path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3"/><path d="M19.5 4v4h-4"/><path d="M10.5 9.5v5l4-2.5z"/>',
  circles: '<circle cx="12" cy="12" r="2.5"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="9.5" stroke-dasharray="2.5 2.5"/>',
  // Sectors and scale
  finance: '<path d="M3.5 9L12 4l8.5 5zM5.5 9v8M10 9v8M14 9v8M18.5 9v8M3.5 20h17"/>',
  health: '<path d="M9.5 4h5v5.5H20v5h-5.5V20h-5v-5.5H4v-5h5.5z"/>',
  legal: '<path d="M6 3.5h12v17H6z"/><path d="M9 8h6M9 11.5h6M9 15h3.5"/>',
  civic: '<path d="M3.5 20.5h17M5 17.5h14M6.5 17.5v-7M10.5 17.5v-7M13.5 17.5v-7M17.5 17.5v-7M4 10.5L12 5l8 5.5z"/>',
  small: '<circle cx="9" cy="9" r="2.5"/><circle cx="16" cy="10" r="2"/><path d="M4.5 18.5a4.5 4.5 0 0 1 9 0M13 18.5a3.2 3.2 0 0 1 6 0"/>',
  enterprise: '<rect x="4" y="3.5" width="10" height="17"/><path d="M14 9.5h6v11h-6M7 7h4M7 10.5h4M7 14h4M17 13h.01M17 16.5h.01"/>',
  // Technology primitives
  find: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5"/>',
  trace: '<circle cx="5" cy="18" r="2"/><circle cx="12" cy="6" r="2"/><circle cx="19" cy="15" r="2"/><path d="M6.2 16.3l4.8-8.6M13.4 7.4l4.4 6"/>',
  compare: '<path d="M4 7h11M12 4l3 3-3 3M20 17H9M12 14l-3 3 3 3"/>',
  assert: '<path d="M5 19l1-4L16 5l3 3L9 18z"/><path d="M4 21h16"/>',
  certify: '<circle cx="12" cy="9.5" r="5.5"/><path d="M9.5 9.6l1.8 1.8 3.2-3.4M8.5 14l-1.5 6.5 5-2.5 5 2.5-1.5-6.5"/>',
  hypothesize: '<circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2" stroke-dasharray="1.5 1.5"/><path d="M7.5 16.5l9-9M8 18h8"/>',
  // Record, rulebook, trail; layers; standards
  record: '<rect x="4.5" y="4" width="15" height="16.5" rx="1"/><path d="M8 8.5h8M8 12h8M8 15.5h4.5"/>',
  rulebook: '<path d="M5 5a2 2 0 0 1 2-2h12v15H7a2 2 0 0 0-2 2z"/><path d="M5 20a2 2 0 0 0 2 1.5h12V18M9 7.5h6"/>',
  trail: '<circle cx="5" cy="19" r="1.8"/><circle cx="19" cy="5" r="1.8"/><path d="M6.5 18c4-1 3-6 6-7s4.5-3 5.2-4.8" stroke-dasharray="2.5 2"/>',
  layers: '<path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z"/><path d="M3.5 12l8.5 4.5 8.5-4.5M3.5 16l8.5 4.5 8.5-4.5"/>',
  standard: '<rect x="4" y="9" width="16" height="6" rx="1"/><path d="M8 9V5M12 9V5M16 9V5M12 15v5"/>',
  window: '<rect x="3.5" y="4.5" width="17" height="15" rx="1"/><path d="M3.5 8.5h17M6 6.5h.01M8.5 6.5h.01"/>',
  instance: '<rect x="4" y="4" width="16" height="16" rx="1"/><circle cx="12" cy="12" r="3.5"/><path d="M10.6 12.1l1 1 1.8-2"/>',
} as const;

const { name, size = 24, label, class: className } = Astro.props;
const body = ICONS[name];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>

<style>
  .icon {
    flex: none;
    color: var(--d-signal, var(--warm));
  }
</style>
