---
// Labelled scenario block.
import { UI, langOf } from '../i18n';

interface Props {
  text: string;
}
const { text } = Astro.props;
---

<figure class="scenario">
  <figcaption class="scenario__label">{UI[langOf(Astro.url)].scenario}</figcaption>
  <p class="scenario__text">{text}</p>
</figure>

<style>
  .scenario {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 0 0 22px;
    border-left: 2px solid var(--warm);
    margin-top: 8px;
  }
  .scenario__label {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
  }
  .scenario__text {
    font-size: var(--fs-body);
    line-height: 1.65;
    font-style: italic;
    font-weight: 300;
    color: var(--paper-strong);
  }
  :global(.band--paper) .scenario {
    border-left-color: var(--accent);
  }
  :global(.band--paper) .scenario__label {
    color: var(--accent);
  }
  :global(.band--paper) .scenario__text {
    font-weight: 400;
    color: var(--ink-strong);
  }
</style>
