---
// Inner-page hero: eyebrow, headline, sub, on the dark canvas.
import TraceRule from './TraceRule.astro';

interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
}
const { eyebrow, title, sub } = Astro.props;
---

<section class="band--dark page-hero" aria-labelledby="page-title">
  <div class="wrap">
    <div class="page-hero__grid">
      <div class="stack stack--lg page-hero__text">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display" id="page-title"><slot name="title">{title}</slot></h1>
        {sub && <p class="lede">{sub}</p>}
        <slot />
      </div>
      <div class="page-hero__trace">
        <TraceRule />
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 40px;
    align-items: end;
  }
  .page-hero__text {
    grid-column: span 9;
  }
  .page-hero__trace {
    grid-column: 10 / span 3;
    justify-self: end;
    padding-bottom: 12px;
  }
  @media (max-width: 900px) {
    .page-hero__text,
    .page-hero__trace {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
