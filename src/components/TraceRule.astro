---
// Short decorative line: three nodes and the seal icon.
---

<svg class="trace-rule" viewBox="0 0 240 24" width="240" height="24" fill="none" aria-hidden="true" focusable="false" data-draw>
  <line class="tr-line draw-line" x1="4" y1="12" x2="212" y2="12" pathLength="1"></line>
  <circle class="tr-node" cx="4" cy="12" r="3.5"></circle>
  <circle class="tr-node" cx="72" cy="12" r="3.5"></circle>
  <circle class="tr-node" cx="140" cy="12" r="3.5"></circle>
  <circle class="tr-seal" cx="224" cy="12" r="10"></circle>
  <path class="tr-seal" d="M219 12 l3.5 3.5 l6.5 -7"></path>
</svg>

<style>
  .trace-rule {
    max-width: 100%;
    height: auto;
  }
  .tr-line {
    stroke: var(--warm);
    stroke-width: 1.5;
  }
  .tr-node {
    fill: var(--warm);
  }
  .tr-seal {
    stroke: var(--warm);
    stroke-width: 1.5;
  }
</style>
