---
// How it works as a visual timeline: numbered stations on one bronze trace,
// each with a small drawing above its words. The last station is the record
// the work leaves behind, passed in through the "end" slot.
import Seal from './Seal.astro';

interface Props {
  steps: { title: string; body: string; visual: 'found' | 'grant' | 'work' }[];
}
const { steps } = Astro.props;
const hasEnd = Astro.slots.has('end');
const total = steps.length + (hasEnd ? 1 : 0);
---

<div class="steps-wrap" data-draw>
  <ol class:list={['steps', `steps--${total}`]}>
    {
      steps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <svg class="step__art draw-fade" viewBox="0 0 200 96" fill="none" aria-hidden="true" focusable="false">
            {s.visual === 'found' && (
              <>
                <path class="dg-line" d="M40 18 L100 70 M100 18 V70 M160 18 L100 70" />
                <circle class="dg-node" cx="40" cy="18" r="6" />
                <circle class="dg-node" cx="100" cy="18" r="6" />
                <circle class="dg-node" cx="160" cy="18" r="6" />
                <rect class="dg-node" x="84" y="62" width="32" height="28" />
                <path class="dg-line" d="M93 76l5 5 10-11" />
              </>
            )}
            {s.visual === 'grant' && (
              <>
                <rect class="step__scope" x="24" y="12" width="112" height="72" />
                <circle class="dg-dot" cx="60" cy="48" r="6" />
                <path class="dg-line" d="M66 48 H100" />
                <circle class="dg-node" cx="106" cy="48" r="6" />
                <path class="step__hair" d="M112 48 H132" />
                <path class="step__stop" d="M140 34 V62" />
                <circle class="dg-node" cx="170" cy="48" r="11" />
                <path class="dg-line" d="M165 48.5l3.5 3.5 6.5-7" />
              </>
            )}
            {s.visual === 'work' && (
              <>
                <path class="dg-line" d="M150 48 L50 16 M150 48 L50 48 M150 48 L50 80" />
                <circle class="dg-node" cx="50" cy="16" r="6" />
                <circle class="dg-node" cx="50" cy="48" r="6" />
                <circle class="dg-node" cx="50" cy="80" r="6" />
                <circle class="dg-dot" cx="150" cy="48" r="9" />
              </>
            )}
          </svg>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </li>
      ))
    }
    {
      hasEnd && (
        <li class="step step--end">
          <span class="step__num" aria-hidden="true">
            <Seal size={20} />
            {String(total).padStart(2, '0')}
          </span>
          <div class="step__end draw-fade">
            <slot name="end" />
          </div>
        </li>
      )
    }
  </ol>
</div>

<style>
  .steps-wrap {
    position: relative;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 36px;
    position: relative;
  }
  .steps--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* The trace itself */
  .steps::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 7px;
    height: 1.5px;
    background: var(--warm);
    transform-origin: left center;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 36px;
  }
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--warm);
    box-sizing: content-box;
  }
  .step--end::before {
    background: var(--warm);
  }
  .step__num {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.18em;
    color: var(--warm);
  }
  .step__art {
    width: 100%;
    max-width: 240px;
    height: auto;
    padding: 12px 0;
    border-block: 1px solid var(--d-hair);
  }
  .step__scope {
    stroke: var(--d-signal);
    stroke-width: 1.25;
    stroke-dasharray: 5 5;
  }
  .step__hair {
    stroke: var(--d-soft);
    stroke-width: 1.25;
    stroke-dasharray: 3 4;
  }
  .step__stop {
    stroke: var(--d-signal);
    stroke-width: 2.5;
  }
  .step__title {
    font-size: 1.375rem;
    line-height: 1.25;
    font-weight: 500;
  }
  .step__body {
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--paper-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawn .steps::before {
      transition: transform 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
  .undrawn .steps::before {
    transform: scaleX(0);
  }

  @media (max-width: 900px) {
    .steps,
    .steps--4 {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding-left: 40px;
    }
    .steps::before {
      left: 7px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1.5px;
      height: auto;
      transform-origin: center top;
    }
    .step {
      padding-top: 0;
    }
    .step::before {
      left: -40px;
      top: 2px;
    }
    .undrawn .steps::before {
      transform: scaleY(0);
    }
  }
</style>
