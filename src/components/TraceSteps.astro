---
// Numbered steps on a connecting line that ends in the seal icon.
import Seal from './Seal.astro';
import Icon from './Icon.astro';
import type { ComponentProps } from 'astro/types';

interface Props {
  steps: { title: string; body: string; icon?: ComponentProps<typeof Icon>['name'] }[];
}
const { steps } = Astro.props;
---

<div class="steps-wrap" data-draw>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">
            {s.icon && <Icon name={s.icon} size={22} />}
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </li>
      ))
    }
  </ol>
  <span class="steps__seal" aria-hidden="true"><Seal size={28} /></span>
</div>

<style>
  .steps-wrap {
    position: relative;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 48px;
    position: relative;
  }
  /* The trace itself */
  .steps::before {
    content: '';
    position: absolute;
    left: 0;
    right: 14px;
    top: 7px;
    height: 1.5px;
    background: var(--warm);
    transform-origin: left center;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 44px;
  }
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--warm);
    box-sizing: content-box;
  }
  .step__num {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.18em;
    color: var(--warm);
  }
  .step__title {
    font-size: var(--fs-h3);
    line-height: 1.25;
    font-weight: 500;
  }
  .step__body {
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--paper-strong);
  }
  .steps__seal {
    position: absolute;
    right: 0;
    top: -7px;
    color: var(--warm);
    background: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawn .steps::before {
      transition: transform 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
  .undrawn .steps::before {
    transform: scaleX(0);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding-left: 40px;
    }
    .steps::before {
      left: 7px;
      right: auto;
      top: 0;
      bottom: -40px;
      width: 1.5px;
      height: auto;
      transform-origin: center top;
    }
    .step {
      padding-top: 0;
    }
    .step::before {
      left: -40px;
      top: 2px;
    }
    .steps__seal {
      left: -6px;
      right: auto;
      top: auto;
      bottom: 0;
    }
    .steps-wrap {
      padding-bottom: 48px;
    }
    .undrawn .steps::before {
      transform: scaleY(0);
    }
  }
</style>
