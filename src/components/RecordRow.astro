---
// A single sample record laid out as labelled columns. Sample content only.
import Seal from './Seal.astro';
import Chip from './Chip.astro';

interface Props {
  caption?: string;
  status?: 'early' | 'roadmap';
}
const { caption, status } = Astro.props;

const cells = [
  { label: 'Record', value: 'Contract renewal approved', kind: 'strong' },
  { label: 'Sources', value: '3 documents' },
  { label: 'Acted', value: 'Procurement agent, for Dana Ortiz' },
  { label: 'Approved', value: 'CFO, passkey' },
  { label: 'Time', value: '14:02 UTC', kind: 'mono' },
  { label: 'Seal', value: 'Sealed', kind: 'seal' },
];
---

<figure class="record">
  <dl class="record__row">
    {
      cells.map((c) => (
        <div class="record__cell">
          <dt>{c.label}</dt>
          <dd class:list={[c.kind && `record__${c.kind}`]}>
            {c.kind === 'seal' && <Seal size={18} />}
            {c.value}
          </dd>
        </div>
      ))
    }
  </dl>
  <figcaption>
    {caption && <span class="record__caption">{caption}</span>}
    {status && <Chip status={status} />}
    <span class="record__tag">Illustrative</span>
  </figcaption>
</figure>

<style>
  .record {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .record__row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--col-gap);
    border-top: 1px solid currentColor;
    border-bottom: 1px solid var(--rule);
  }
  .record__cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 0 22px;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  dd {
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .record__strong {
    font-weight: 500;
  }
  .record__mono {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
  }
  .record__seal {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 500;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    max-width: 48rem;
  }
  .record__caption {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-strong);
  }
  .record__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 1100px) {
    .record__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .record__cell:nth-child(n + 4) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 560px) {
    .record__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .record__cell {
      flex-direction: row;
      align-items: baseline;
      gap: 16px;
      padding: 12px 0;
    }
    .record__cell + .record__cell {
      border-top: 1px solid var(--rule);
    }
    dt {
      flex: 0 0 6.5rem;
    }
  }
</style>
