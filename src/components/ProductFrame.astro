---
// Abstract window frame with placeholder bars.
interface Props {
  title: string;
  variant?: 'console' | 'app';
}
const { title, variant = 'console' } = Astro.props;
---

<div class:list={['frame', `frame--${variant}`]} aria-hidden="true">
  <div class="frame__bar">
    <span class="frame__dots"><i></i><i></i><i></i></span>
    <span class="frame__title">{title}</span>
  </div>
  <div class="frame__body">
    {
      variant === 'console' ? (
        <>
          <div class="frame__side">
            <b></b>
            <b></b>
            <b></b>
            <b></b>
            <b></b>
          </div>
          <div class="frame__main">
            <b class="w60"></b>
            <b class="row"></b>
            <b class="row"></b>
            <b class="row seal"></b>
            <b class="row"></b>
          </div>
        </>
      ) : (
        <div class="frame__main">
          <b class="w40"></b>
          <b class="card"></b>
          <b class="card"></b>
          <b class="w60"></b>
          <b class="row"></b>
        </div>
      )
    }
  </div>
</div>

<style>
  .frame {
    border: 1px solid var(--rule);
    background: #fff;
    background: color-mix(in srgb, var(--paper) 60%, white);
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
  }
  .frame__dots {
    display: flex;
    gap: 6px;
  }
  .frame__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--rule);
  }
  .frame__title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .frame__body {
    display: flex;
    gap: 18px;
    padding: 18px;
    height: 232px;
    overflow: hidden;
  }
  .frame__side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 26%;
    padding-right: 14px;
    border-right: 1px solid var(--rule);
  }
  .frame__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  b {
    display: block;
    height: 8px;
    background: var(--rule);
  }
  .frame__side b:first-child {
    background: var(--accent);
    opacity: 0.7;
  }
  .w60 {
    width: 60%;
    height: 12px;
    background: var(--ink-soft);
    opacity: 0.5;
  }
  .w40 {
    width: 40%;
    height: 12px;
    background: var(--ink-soft);
    opacity: 0.5;
  }
  .row {
    height: 22px;
    background: transparent;
    border-bottom: 1px solid var(--rule);
  }
  .row.seal {
    border-bottom-color: var(--accent);
  }
  .card {
    height: 44px;
    background: transparent;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
  }
</style>
