---
// Decorative: a trace that does not hold together, for the problem section.
---

<svg class="broken" viewBox="0 0 420 260" fill="none" aria-hidden="true" focusable="false" data-draw>
  <g class="broken__hair">
    <line x1="40" y1="200" x2="130" y2="120"></line>
    <line x1="150" y1="104" x2="210" y2="60"></line>
    <line x1="230" y1="70" x2="300" y2="130"></line>
    <line x1="318" y1="146" x2="380" y2="200"></line>
  </g>
  <g class="broken__nodes">
    <circle cx="40" cy="200" r="6"></circle>
    <circle cx="140" cy="112" r="6"></circle>
    <circle cx="220" cy="62" r="6"></circle>
    <circle cx="310" cy="138" r="6"></circle>
  </g>
  <g class="broken__gap draw-fade">
    <circle cx="380" cy="200" r="14"></circle>
    <path d="M374 194l12 12M386 194l-12 12"></path>
  </g>
</svg>

<style>
  .broken {
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-inline: auto;
  }
  .broken__hair line {
    stroke: var(--d-soft);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .broken__nodes circle {
    fill: none;
    stroke: var(--d-soft);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  .broken__gap circle,
  .broken__gap path {
    stroke: var(--d-signal);
    stroke-width: 1.5;
  }
</style>
