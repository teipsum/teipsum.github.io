---
// Diagram: who can read a person's words to their twin.
import Icon from '../Icon.astro';
import { pick } from '../../i18n';

const t = pick(Astro.url, {
  en: {
    alt: "Diagram: a person's words to their twin can be read by that person and, where required, their auditor. An administrator cannot read them.",
    head: 'Your words to your twin',
    who: ['You', 'Your auditor, where required', 'Administrator'],
    can: 'Can read',
    cannot: 'Cannot read',
  },
  es: {
    alt: 'Diagrama: lo que una persona le dice a su gemelo lo pueden leer esa persona y, cuando se exija, su auditor. Un administrador no puede leerlo.',
    head: 'Lo que le dices a tu gemelo',
    who: ['Tú', 'Tu auditor, cuando se exija', 'Administrador'],
    can: 'Puede leer',
    cannot: 'No puede leer',
  },
});
const rows = [
  { who: t.who[0], can: true },
  { who: t.who[1], can: true },
  { who: t.who[2], can: false },
];
---

<div
  class="dg ra"
  role="img"
  aria-label={t.alt}
  data-draw
>
  <div class="ra__head">
    <span class="ra__icon"><Icon name="lock" size={22} /></span>
    <span class="dg-label dg-label--signal">{t.head}</span>
  </div>
  <ul class="ra__rows">
    {
      rows.map((r) => (
        <li class:list={['draw-fade', !r.can && 'ra__row--no']}>
          <span>{r.who}</span>
          <span class="ra__mark" aria-hidden="true">
            {r.can ? (
              <svg viewBox="0 0 20 20" width="20" height="20"><path d="M4 10.5l4 4 8-9" /></svg>
            ) : (
              <svg viewBox="0 0 20 20" width="20" height="20"><path d="M5 5l10 10M15 5L5 15" /></svg>
            )}
          </span>
          <span class="dg-label">{r.can ? t.can : t.cannot}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .ra {
    max-width: 480px;
    margin-inline: auto;
    border: 1px solid var(--d-hair);
    background: var(--d-lift);
  }
  .ra__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--d-signal);
  }
  .ra__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--d-signal);
    border-radius: 50%;
  }
  .ra__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ra__rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 6.5rem;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    font-size: 1rem;
    color: var(--d-ink);
  }
  .ra__rows li + li {
    border-top: 1px solid var(--d-hair);
  }
  .ra__mark svg {
    fill: none;
    stroke: var(--d-signal);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .ra__row--no {
    color: var(--d-soft);
  }
  .ra__row--no > span:first-child {
    text-decoration: line-through;
    text-decoration-color: var(--d-soft);
  }
  .ra__row--no .ra__mark svg {
    stroke: var(--d-soft);
  }
</style>
