---
// Diagram: one dedicated instance, brought to life by its Trustees' keys.
import Icon from '../Icon.astro';
import { pick } from '../../i18n';

interface Props {
  alt?: string;
}
const t = pick(Astro.url, {
  en: {
    alt: 'Diagram: one dedicated instance with its own boundary, established by three Trustees, each with their own passkey.',
    trustee: 'Trustee',
    instance: 'Your instance',
  },
  es: {
    alt: 'Diagrama: una instancia dedicada con su propio límite, establecida por tres Fideicomisarios, cada uno con su propia llave de acceso.',
    // A soft hyphen lets the long word break when three labels share a phone width.
    trustee: 'Fideico\u00ADmisario',
    instance: 'Tu instancia',
  },
});
const { alt = t.alt } = Astro.props;
---

<div class="dg inst" role="img" aria-label={alt} data-draw>
  <ul class="inst__keys">
    {
      [1, 2, 3].map(() => (
        <li class="draw-fade">
          <span class="inst__key"><Icon name="key" size={20} /></span>
          <span class="dg-label">{t.trustee}</span>
        </li>
      ))
    }
  </ul>
  <svg class="inst__links" viewBox="0 0 300 70" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path class="dg-line draw-line" d="M50 0 C 50 40, 150 30, 150 70" pathLength="1"></path>
    <path class="dg-line draw-line" d="M150 0 L150 70" pathLength="1"></path>
    <path class="dg-line draw-line" d="M250 0 C 250 40, 150 30, 150 70" pathLength="1"></path>
  </svg>
  <div class="inst__box">
    <span class="inst__seal"><Icon name="instance" size={28} /></span>
    <span class="dg-label dg-label--signal">{t.instance}</span>
    <span class="inst__edge" aria-hidden="true"></span>
  </div>
</div>

<style>
  .inst {
    max-width: 460px;
    margin-inline: auto;
  }
  .inst__keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .inst__keys li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .inst__key {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--d-signal);
    border-radius: 50%;
    background: var(--d-ground);
  }
  .inst__links {
    display: block;
    width: 100%;
    height: 64px;
  }
  .inst__links path {
    vector-effect: non-scaling-stroke;
  }
  .inst__box {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 28px 20px;
    border: 1px solid var(--d-signal);
    background: var(--d-lift);
  }
  .inst__edge {
    position: absolute;
    inset: 8px;
    border: 1px dashed var(--d-hair);
    pointer-events: none;
  }
  .inst__seal {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1.5px solid var(--d-signal);
  }
</style>
