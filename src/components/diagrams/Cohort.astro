---
// Diagram: the founding cohort, admitted in waves. Each wave is a small group
// of organizations with its own direct line to the people building Unica.
import Icon from '../Icon.astro';
import { pick } from '../../i18n';

const t = pick(Astro.url, {
  en: {
    alt: 'Diagram: the founding cohort admitted in three waves. Each wave is a small group of organizations, and each wave has its own direct line to the people building Unica.',
    title: 'Founding cohort',
    waves: ['Wave 1', 'Wave 2', 'Wave 3'],
    org: 'Organization',
    line: 'Direct line',
  },
  es: {
    alt: 'Diagrama: la cohorte fundadora, admitida en tres oleadas. Cada oleada es un grupo pequeño de organizaciones con su propia línea directa con las personas que construyen Unica.',
    title: 'Cohorte fundadora',
    waves: ['Oleada 1', 'Oleada 2', 'Oleada 3'],
    org: 'Organización',
    line: 'Línea directa',
  },
});
const waves = t.waves;
const orgs = Array.from({ length: 6 });
---

<div
  class="dg cohort"
  role="img"
  aria-label={t.alt}
  data-draw
>
  <p class="dg-label dg-label--signal cohort__title">{t.title}</p>
  <div class="cohort__rows">
    {
      waves.map((w) => (
        <div class="wave draw-fade">
          <span class="dg-label wave__label">{w}</span>
          <span class="wave__orgs">
            {orgs.map(() => (
              <i class="org" />
            ))}
          </span>
          <span class="wave__line" />
          <span class="wave__team">
            <Icon name="roles" size={18} />
          </span>
        </div>
      ))
    }
  </div>
  <div class="cohort__key">
    <span class="dg-label"><i class="org org--key"></i>{t.org}</span>
    <span class="dg-label"><i class="key-line"></i>{t.line}</span>
  </div>
</div>

<style>
  .cohort {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
    padding-top: 20px;
    border-top: 1px solid var(--d-hair);
  }
  .cohort__rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .wave {
    display: grid;
    grid-template-columns: minmax(4.5rem, max-content) auto minmax(16px, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  .wave__label {
    white-space: nowrap;
  }
  .wave__orgs {
    display: flex;
    gap: 6px;
  }
  .org {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 1px solid var(--d-signal);
  }
  .wave__line {
    height: 0;
    border-top: 1.5px solid var(--d-signal);
  }
  .wave__team {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--d-signal);
    border-radius: 50%;
    color: var(--d-signal);
  }
  .cohort__key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .cohort__key .dg-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .org--key {
    width: 12px;
    height: 12px;
  }
  .key-line {
    display: inline-block;
    width: 18px;
    border-top: 1.5px solid var(--d-signal);
  }
  @media (max-width: 400px) {
    .wave {
      grid-template-columns: minmax(4rem, max-content) auto minmax(8px, 1fr) auto;
      gap: 8px;
    }
    .wave__orgs {
      gap: 4px;
    }
    .org {
      width: 12px;
      height: 12px;
    }
  }
</style>
