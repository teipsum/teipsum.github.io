---
// Diagram: agents and apps on top ask; one layer underneath decides; your data
// sits below it.
import Icon from '../Icon.astro';
import type { ComponentProps } from 'astro/types';

interface Props {
  top?: { label: string; icon: ComponentProps<typeof Icon>['name'] }[];
  base?: string[];
  baseLabel?: string;
  dataLabel?: string;
  alt?: string;
}
const {
  top = [
    { label: 'Agents', icon: 'build' },
    { label: 'Twins', icon: 'twin' },
    { label: 'Apps', icon: 'window' },
  ],
  base = ['Identity', 'Permissions', 'Memory', 'Approvals', 'Record'],
  baseLabel = 'One layer underneath',
  dataLabel = 'Your data',
  alt = 'Diagram: agents, twins and apps sit on top and can only ask. One layer underneath holds identity, permissions, memory, approvals and the record, and makes every decision. Your data sits below that layer.',
} = Astro.props;
---

<div class="dg os" role="img" aria-label={alt} data-draw>
  <ul class="os__top">
    {
      top.map((t) => (
        <li class="os__tile draw-fade">
          <Icon name={t.icon} size={22} />
          <span class="dg-label">{t.label}</span>
        </li>
      ))
    }
  </ul>
  <div class="os__mid">
  <svg class="os__links" viewBox="0 0 300 56" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <line class="dg-hair" x1="50" y1="0" x2="50" y2="56"></line>
    <line class="dg-hair" x1="150" y1="0" x2="150" y2="56"></line>
    <line class="dg-hair" x1="250" y1="0" x2="250" y2="56"></line>
    <line class="dg-line draw-line" x1="50" y1="56" x2="50" y2="0" pathLength="1"></line>
    <line class="dg-line draw-line" x1="150" y1="56" x2="150" y2="0" pathLength="1"></line>
    <line class="dg-line draw-line" x1="250" y1="56" x2="250" y2="0" pathLength="1"></line>
  </svg>
  <div class="os__legend" aria-hidden="true">
    <span class="dg-label">Asks</span>
    <span class="dg-label dg-label--signal">Decides</span>
  </div>
  </div>
  <div class="os__base">
    <span class="dg-label dg-label--signal">{baseLabel}</span>
    <ul class="os__chips">
      {base.map((b) => <li>{b}</li>)}
    </ul>
  </div>
  <div class="os__data draw-fade">
    <Icon name="layers" size={18} />
    <span class="dg-label">{dataLabel}</span>
  </div>
</div>

<style>
  .os {
    position: relative;
    max-width: 560px;
    margin-inline: auto;
  }
  .os__top {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .os__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 8px;
    border: 1px solid var(--d-hair);
    background: var(--d-lift);
  }
  .os__links {
    display: block;
    width: calc(100% - 0px);
    height: 56px;
  }
  .os__links line {
    vector-effect: non-scaling-stroke;
  }
  .os__mid {
    position: relative;
  }
  .os__legend span {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  .os__legend span:first-child {
    left: 33.3%;
  }
  .os__legend span:last-child {
    left: 66.7%;
  }
  .os__base {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--d-signal);
    border-top-width: 3px;
  }
  .os__data {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    border: 1px solid var(--d-hair);
    border-top: 0;
    background: var(--d-lift);
    color: var(--d-soft);
  }
  .os__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .os__chips li {
    padding: 6px 12px;
    border: 1px solid var(--d-hair);
    font-size: 0.9375rem;
    color: var(--d-ink);
  }
</style>
