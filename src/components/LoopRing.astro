---
// Loop figure: an outer ring in four segments with an unbroken inner line.
// The gaps between segments close as the figure comes into view.
import { pick } from '../i18n';

const t = pick(Astro.url, {
  en: {
    alt: 'The loop: identity, governed action, human attestation and verifiable evidence, closed into one ring. One record. One rulebook. One trail.',
    identity: 'IDENTITY',
    action: ['GOVERNED', 'ACTION'],
    attestation: 'HUMAN ATTESTATION',
    evidence: ['VERIFIABLE', 'EVIDENCE'],
    center: ['One record.', 'One rulebook.', 'One trail.'],
  },
  es: {
    alt: 'El ciclo: identidad, acción gobernada, atestación humana y evidencia verificable, cerrados en un solo anillo. Un registro. Un reglamento. Un rastro.',
    identity: 'IDENTIDAD',
    action: ['ACCIÓN', 'GOBERNADA'],
    attestation: 'ATESTACIÓN HUMANA',
    evidence: ['EVIDENCIA', 'VERIFICABLE'],
    center: ['Un registro.', 'Un reglamento.', 'Un rastro.'],
  },
});
---

<svg class="loop" data-draw viewBox="-150 0 1060 760" fill="none" role="img" aria-label={t.alt}>
  <circle class="loop__track" cx="380" cy="380" r="270"></circle>
  <circle class="loop__arcs" cx="380" cy="380" r="270" transform="rotate(-86 380 380)"></circle>
  <circle class="loop__trace draw-line" cx="380" cy="380" r="232" pathLength="1" transform="rotate(-90 380 380)"></circle>
  <g class="loop__nodes">
    <circle cx="380" cy="148" r="6"></circle>
    <circle cx="612" cy="380" r="6"></circle>
    <circle cx="380" cy="612" r="6"></circle>
    <circle cx="148" cy="380" r="6"></circle>
  </g>
  <g class="loop__labels">
    <text x="380" y="68" text-anchor="middle">{t.identity}</text>
    <text x="890" y="374" text-anchor="end">{t.action[0]}</text>
    <text x="890" y="400" text-anchor="end">{t.action[1]}</text>
    <text x="380" y="718" text-anchor="middle">{t.attestation}</text>
    <text x="-130" y="374">{t.evidence[0]}</text>
    <text x="-130" y="400">{t.evidence[1]}</text>
  </g>
  <g class="loop__center" text-anchor="middle">
    <text x="380" y="352">{t.center[0]}</text>
    <text x="380" y="394">{t.center[1]}</text>
    <text class="loop__warm" x="380" y="436">{t.center[2]}</text>
  </g>
</svg>

<style>
  .loop {
    width: 100%;
    max-width: 680px;
    height: auto;
    margin-inline: auto;
  }
  .loop__track {
    stroke: rgba(247, 245, 240, 0.1);
    stroke-width: 28;
  }
  .loop__arcs {
    stroke: var(--accent);
    stroke-width: 28;
    stroke-dasharray: 392 32;
    opacity: 0.6;
  }
  .loop__trace {
    stroke: var(--warm);
    stroke-width: 1.5;
  }
  .loop__nodes circle {
    fill: var(--warm);
  }
  .loop__labels text {
    font-family: var(--font-mono);
    font-size: 20px;
    letter-spacing: 2.6px;
    fill: var(--paper);
  }
  .loop__center text {
    font-family: var(--font-sans);
    font-size: 34px;
    font-weight: 500;
    fill: var(--paper);
  }
  .loop__center .loop__warm {
    fill: var(--warm);
  }

  /* The seams close and the trace draws as the ring comes into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.drawn) .loop__arcs {
      transition: stroke-dasharray 1.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
    }
  }
  :global(.undrawn) .loop__arcs {
    stroke-dasharray: 360 64;
  }
</style>
