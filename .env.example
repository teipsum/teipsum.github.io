# Copy to .env for local builds. In CI these come from repository variables.

# Full HTTPS URL the waitlist form POSTs to (JSON body). Leave empty to show
# the "not accepting requests yet" message instead of sending.
PUBLIC_WAITLIST_ENDPOINT=

# Cloudflare Web Analytics site token. Leave empty to use the default in src/config.ts.
PUBLIC_CF_BEACON_TOKEN=

# Company LinkedIn page. Leave empty to omit the footer link.
PUBLIC_LINKEDIN_URL=

# Privacy notice effective date, as it should read on /privacy/ (for example
# "October 1, 2026"). Set at launch. Leave empty to omit the date line.
PUBLIC_PRIVACY_EFFECTIVE_DATE=
